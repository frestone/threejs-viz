{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "threeJs_VIZ",
  "version": "0.1.0",
  "identifier": "com.threejs.viz",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Three.js Viz",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../server/configs/data_profiles.json": "configs/data_profiles.json",
      "../server/configs/decoder.json": "configs/decoder.json",
      "../server/configs/decoder_lightmap.json": "configs/decoder_lightmap.json",
      "../server/configs/s3.json": "configs/s3.json"
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/bin/configs/data_profiles.json": "resources/configs/data_profiles.json",
          "/usr/bin/configs/decoder.json": "resources/configs/decoder.json",
          "/usr/bin/configs/decoder_lightmap.json": "resources/configs/decoder_lightmap.json",
          "/usr/bin/configs/s3.json": "resources/configs/s3.json"
        }
      }
    }
  }
}