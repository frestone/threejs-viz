  ],

  "charts": [
    {
      "id": "speed",
      "title": "速度 (odometry.twist.linear)",
      "xLabel": "t (s)",
      "yLabel": "v (m/s)",
      "visible": true,
      "series": [
        { "name": "vx", "xField": "t", "yField": "odometry.twist.linear.x", "kind": "line", "color": "#ff6699" },
        { "name": "vy", "xField": "t", "yField": "odometry.twist.linear.y", "kind": "line", "color": "#66ff99" }
      ]
    }
  ],

  "//pointClouds": "点云图层配置。每项声明一个点云通道如何从 MCAP topic 提取 + 前端渲染样式。默认空数组=不订阅/不解码任何点云 topic(零成本)。示例结构见下方注释项。",
  "//pointCloudsExample": {
