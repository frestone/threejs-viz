"""macOS 系统依赖(zstd / openssl / jpeg)前缀探测。

macOS 链路里三个系统库由包管理器提供(Homebrew 默认,也可是 conda / MacPorts /
自定义前缀),而 BUILD 文件读不到环境变量,故用 repository_rule 在 fetch 阶段探测
一次,生成携带 -I/-L 的小 cc_library:

    @viz_sys_prefix//:zstd / :openssl / :jpeg

探测顺序:
  1. 环境变量 VIZ_SYS_PREFIX(最高优先级,任意前缀)
  2. Homebrew 默认前缀 /opt/homebrew(Apple Silicon)或 /usr/local(Intel)
  3. `brew --prefix`(Homebrew 装在非默认位置且已在 PATH)

覆盖方式:
    export VIZ_SYS_PREFIX=/your/prefix        # 或
    common --repo_env=VIZ_SYS_PREFIX=/your/prefix   # 写进 .bazelrc
改值后 Bazel 会因 environ 声明而自动重新 fetch(必要时 bazel clean --expunge)。

openssl 单独处理:Homebrew 的 openssl@3 是 keg-only,头/库在
<prefix>/opt/openssl@3/{include,lib},不在 <prefix>/{include,lib};conda 等前缀
则与本前缀一致。
"""

# 头文件以【逐文件符号链接】挂进本仓库并显式列进 hdrs,两个原因:
#   1) cc_library 的 includes 必须是包内相对路径 —— 绝对路径会被 Bazel 规范化掉,
#      编译期根本不会出现在 -isystem 上;
#   2) 只 symlink 整个目录不行 —— darwin-sandbox 只挂载 action 的【声明输入】,
#      没有被 hdrs 列到的目录在沙箱里不存在,头文件自然找不到。
# 库搜索路径(-L)可以直接写绝对路径:linkopts 原样透传给链接器。
#
# 注意:下面 _BUILD_TEMPLATE / _MISSING_BUILD 的正文必须是 ASCII —— Bazel 以
# Latin-1 读取 .bzl 源码,repository_ctx.file 写文件时又按 UTF-8 编码,中文会被
# 双重编码成乱码(实测)。注释与代码用英文,需要中文说明的写在 .bzl 本体里。
_BUILD_TEMPLATE = """\
# Generated by //server/third_party:sys_prefix.bzl at fetch time. Do not edit.
# Detected system dependency prefix: {prefix} (source: {source})
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Header files from the prefix, symlinked one by one into include/.
_HEADERS = {headers}

cc_library(
    name = "zstd",
    hdrs = _HEADERS,
    includes = ["include"],
    linkopts = [
        "-L{prefix}/lib",
        "-Wl,-rpath,{prefix}/lib",
        "-lzstd",
    ],
)

cc_library(
    name = "openssl",
    hdrs = _HEADERS,
    includes = ["include"],
    linkopts = [
        "-L{openssl_lib}",
        "-Wl,-rpath,{openssl_lib}",
        "-lssl",
        "-lcrypto",
    ],
)

cc_library(
    name = "jpeg",
    hdrs = _HEADERS,
    includes = ["include"],
    linkopts = [
        "-L{prefix}/lib",
        "-Wl,-rpath,{prefix}/lib",
        "-ljpeg",
    ],
)
"""

# 前缀缺失时生成的占位 BUILD:被 macOS 构建引用即报出可操作的错误。
_MISSING_BUILD = """\
# Generated by //server/third_party:sys_prefix.bzl at fetch time.
fail(
    "macOS system dependency prefix not found (zstd / openssl / jpeg). Pick one:\\n" +
    "  1) brew install zstd openssl@3 jpeg   # default prefixes /opt/homebrew or /usr/local\\n" +
    "  2) export VIZ_SYS_PREFIX=/your/prefix # conda / MacPorts / custom location\\n" +
    "  3) VIZ_SKIP_FFI_LINK=1 npm run tauri:dev   # frontend-only, skips FFI linking",
)
"""

def _detect(repository_ctx):
    env_prefix = repository_ctx.os.environ.get("VIZ_SYS_PREFIX", "")
    if env_prefix:
        # source 会被写进生成的 BUILD 文件,必须是 ASCII(Bazel 按 Latin-1 读 .bzl)。
        return env_prefix, "VIZ_SYS_PREFIX env"

    for candidate in ["/opt/homebrew", "/usr/local"]:
        if repository_ctx.path(candidate + "/bin/brew").exists:
            return candidate, "Homebrew default prefix"

    brew = repository_ctx.which("brew")
    if brew != None:
        result = repository_ctx.execute([str(brew), "--prefix"], timeout = 60)
        if result.return_code == 0 and result.stdout.strip():
            return result.stdout.strip(), "brew --prefix"

    return "", ""

def _collect_files(root):
    """收集 root 下所有文件,返回相对 root 的路径列表。

    Starlark 既不支持递归也不支持 while,故用「索引 + 动态增长的目录列表」做 BFS。
    """
    # 注意:readdir() 返回 path 对象而非名字字符串;str(root) 末尾无斜杠,故 +1。
    root_len = len(str(root)) + 1
    acc = []
    dirs = [root]
    for i in range(1000):
        if i >= len(dirs):
            break
        for child in dirs[i].readdir():
            if child.is_dir:
                dirs.append(child)
            else:
                acc.append(str(child)[root_len:])
    return acc

def _link_headers(repository_ctx, include_dirs):
    """把各 include 目录下的头文件 symlink 到仓库 include/ 下,返回 hdrs 列表。

    前缀目录优先(Homebrew 的 openssl@3 是 keg-only,单独一处 include)。同名前缀
    文件只链一次,避免 cc_library 里出现重复 hdrs。
    """
    linked = {}
    for dir_path in include_dirs:
        root = repository_ctx.path(dir_path)
        if not root.exists:
            continue
        for rel in _collect_files(root):
            if rel in linked:
                continue
            repository_ctx.symlink(dir_path + "/" + rel, "include/" + rel)
            linked[rel] = "include/" + rel
    return sorted(linked.values())

def _impl(repository_ctx):
    prefix, source = _detect(repository_ctx)

    if not prefix:
        repository_ctx.file("BUILD.bazel", _MISSING_BUILD)
        return

    # Homebrew 的 openssl 是 keg-only:keg 优先,否则回落到前缀自身。
    # 注意:asio 1.28 与 OpenSSL 4 不兼容(ASN1_STRING 变成不完整类型),需 3.x。
    openssl_include = prefix + "/include"
    openssl_lib = prefix + "/lib"
    for keg in ["/opt/openssl@3", "/opt/openssl"]:
        if repository_ctx.path(prefix + keg + "/include").exists:
            openssl_include = prefix + keg + "/include"
            openssl_lib = prefix + keg + "/lib"
            break

    headers = _link_headers(repository_ctx, [prefix + "/include", openssl_include])

    repository_ctx.file(
        "BUILD.bazel",
        _BUILD_TEMPLATE.format(
            prefix = prefix,
            source = source,
            openssl_lib = openssl_lib,
            headers = "[\n" + "".join(["    \"{}\",\n".format(h) for h in headers]) + "]",
        ),
    )

viz_sys_prefix = repository_rule(
    implementation = _impl,
    environ = ["VIZ_SYS_PREFIX"],
    local = True,
    doc = "探测 macOS 系统依赖(zstd/openssl/jpeg)前缀并生成 -I/-L 包装库。",
)
